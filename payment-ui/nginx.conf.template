server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Compressione risposte testuali
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_proxied any;
    gzip_vary on;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml
        font/woff2;

    # Risolve i nomi dei servizi Docker a ogni richiesta (evita IP obsoleti dopo il recreate del container).
    resolver 127.0.0.11 valid=10s ipv6=off;

    # BFF: il browser chiama /api/* su questo host; nginx inietta X-Api-Key lato server.
    location /api/ {
        set $backend "payment-service:8080";
        proxy_pass http://$backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Api-Key ${PAYMENT_API_KEY};
        # Nessuna cache sulle API
        add_header Cache-Control "no-store" always;
    }

    # Asset Vite hashed → cache lunga immutabile
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Font self-hosted
    location ~* \.(woff2|woff)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
