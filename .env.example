# Copia in .env e adatta per Docker Compose locale.
COMPOSE_PROJECT_NAME=payment-gateway

POSTGRES_DB=payments
POSTGRES_USER=payments_user
POSTGRES_PASSWORD=payments_pass

# Usata dal BFF payment-ui (nginx) e dal proxy Vite in dev — mai inclusa nel bundle JS.
PAYMENT_API_KEY=pgw-demo-key-32chars-minimum!!

# Token condiviso tra notification-service → webhook-receiver e scrape Prometheus.
INTERNAL_SERVICE_TOKEN=pgw-internal-demo-token

# Outbox: default = relay Java (affidabile in CI/demo).
# Per CDC Debezium: PAYMENT_OUTBOX_RELAY_ENABLED=false, CDC_ACK=true e
#   docker compose --profile debezium up -d
PAYMENT_OUTBOX_RELAY_ENABLED=true
PAYMENT_OUTBOX_CDC_ACK_ENABLED=false

# Processore: mock (default CI/demo) oppure stripe
PAYMENT_PROCESSOR_PROVIDER=mock
# Chiave test Stripe (sk_test_...) — richiesta se PROVIDER=stripe
STRIPE_API_KEY=
# PaymentMethod di test: pm_card_visa | pm_card_mastercard | pm_card_chargeDeclined
STRIPE_DEFAULT_PAYMENT_METHOD=pm_card_visa
# Webhook inbound Stripe (stripe listen --forward-to localhost:8080/api/v1/stripe/webhooks)
STRIPE_WEBHOOKS_ENABLED=false
STRIPE_WEBHOOK_SECRET=

# Webhook HMAC secret (deve coincidere col seed merchant / verifica lato merchant)
NOTIFICATION_WEBHOOK_SECRET=whsec_demo_payment_gateway_local

# Solo overlay prod (docker-compose.prod.yml)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
